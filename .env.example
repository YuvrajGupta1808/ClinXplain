# Redis (required for RAG pipeline)
# Use Redis Cloud URL or local: redis://localhost:6379
# For Redis Cloud TLS use rediss://
REDIS_URL=redis://default:YOUR_PASSWORD@YOUR_REDIS_HOST:10548

# OpenAI (required for embeddings and generation)
OPENAI_API_KEY=sk-your-openai-api-key

# Weights & Biases / Weave (optional, for tracing and evaluation)
WANDB_API_KEY=your-wandb-api-key
# WANDB_LLM_MODEL=openai/gpt-oss-20b  # or openai/gpt-oss-120b when using W&B for LLM
# WEAVE_PROJECT=your-team/rag-eval
# RAG_EVAL_JUDGE_MODEL=gpt-4o-mini

# Optional RAG settings
# RAG_INDEX_NAME=rag_docs
# RAG_INDEX_PREFIX=rag_docs
# RAG_EMBEDDING_MODEL=text-embedding-3-small
# RAG_EMBEDDING_DIMENSIONS=1536
# RAG_CHUNK_SIZE=1000
# RAG_CHUNK_OVERLAP=200
# RAG_TOP_K=5
# RAG_LLM_MODEL=gpt-4o-mini
# RAG_LLM_TEMPERATURE=0.0
# RAG_CACHE_TTL=3600  # Redis LLM cache TTL (seconds); 0 = disable
